PORT=3000
NODE_ENV=development

# URL base API UniPlay.
# WAJIB cek ulang dengan dokumentasi/collection Postman UniPlay Anda.
UNIPLAY_BASE_URL=https://api.uniplay.id

# API Key dari panel/member UniPlay Anda.
UNIPLAY_API_KEY=ISI_API_KEY_UNIPLAY_ANDA

# Jika API UniPlay memerlukan PIN transaksi, isi di sini.
UNIPLAY_PIN=ISI_PIN_TRANSAKSI_ANDA

# Ubah endpoint sesuai dokumentasi UniPlay resmi Anda.
UNIPLAY_ENDPOINT_PRODUCTS=/api/products
UNIPLAY_ENDPOINT_INQUIRY=/api/inquiry
UNIPLAY_ENDPOINT_ORDER=/api/order
UNIPLAY_ENDPOINT_STATUS=/api/order/status
